# MySQL database used by Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev (Laragon): mysql://root:@localhost:3306/portofoliorasya
# Docker compose:      mysql://appuser:apppass@db:3306/portofoliorasya
DATABASE_URL="mysql://root:@localhost:3306/portofoliorasya"

# Secret used to sign the admin session cookie
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-in-production"

# Public URL of the app (used in dev tooling / deployment)
NEXTAUTH_URL="http://localhost:3000"

# ---- Docker compose only (Ubuntu production) ----
# MYSQL_ROOT_PASSWORD="super-secret-root"
# MYSQL_DATABASE="portofoliorasya"
# MYSQL_USER="appuser"
# MYSQL_PASSWORD="super-secret-app"
# Cloudflare Tunnel token (Zero Trust dashboard). Leave empty to skip the
# bundled cloudflared service and run the tunnel elsewhere.
# CLOUDFLARE_TUNNEL_TOKEN=""
